# Python cache và môi trường cục bộ
__pycache__/
*.py[cod]
.venv/
venv/
env/
.env
.env.local

# Cache, coverage và artifact tạm của công cụ kiểm thử
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage*
htmlcov/

# File runtime không thuộc source hoặc release bundle
data/runtime/
*.sqlite3

# File build/package và cấu hình IDE
build/
dist/
*.egg-info/
.idea/
.vscode/

# Model nhị phân sinh trong quá trình train; release JSON vẫn được commit
models/*.joblib
models/*.pkl
models/*.bin
artifacts/**/*.joblib
artifacts/**/*.pkl
artifacts/**/*.bin
!artifacts/model.joblib

# Đường dẫn legacy không được runtime mới đọc
artifacts/champion/
models/
releases/

# Dataset tải về; bản CSV hiện tại vẫn được giữ trong Git vì đã track
data/raw/*.csv
data/raw/*.parquet
