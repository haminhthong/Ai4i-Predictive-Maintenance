# Python cache và môi trường cục bộ
__pycache__/
*.py[cod]
.venv/
venv/
env/
.env
.env.local

# Cache, coverage và artifact tạm của công cụ kiểm thử
.pytest_cache/
.pytest_tmp/
.ruff_cache/
.mypy_cache/
.coverage*
.htmlcov/

# File runtime không thuộc source
data/runtime/
*.sqlite3

# File build/package và cấu hình IDE
build/
dist/
*.egg-info/
.idea/
.vscode/

# Model nhị phân sinh trong quá trình train; chỉ artifact active ở thư mục gốc được giữ.
artifacts/**/*.joblib
artifacts/**/*.pkl
artifacts/**/*.bin
!artifacts/model.joblib

# Dataset tải về; bản CSV hiện tại vẫn được giữ trong Git vì đã track
data/raw/*.csv
data/raw/*.parquet
